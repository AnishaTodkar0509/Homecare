<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/homecare_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <!-- Title -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Appliance"
            android:textColor="@color/homecare_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Add your appliance details"
            android:textColor="@color/homecare_secondary_text"
            android:textSize="14sp" />

        <!-- Appliance Name -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Appliance Name"
            android:textColor="@color/homecare_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etApplianceName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="e.g. Living Room AC"
            android:inputType="textCapSentences"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/homecare_text"
            android:textColorHint="@color/homecare_muted_text" />

        <!-- Category -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Category"
            android:textColor="@color/homecare_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spCategory"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input" />

        <!-- Brand -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Brand"
            android:textColor="@color/homecare_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBrand"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="e.g. Samsung"
            android:inputType="textCapSentences"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/homecare_text"
            android:textColorHint="@color/homecare_muted_text" />

        <!-- Model Number -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Model Number"
            android:textColor="@color/homecare_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etModelNumber"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Enter model number"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/homecare_text"
            android:textColorHint="@color/homecare_muted_text" />

        <!-- Purchase Date -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Purchase Date"
            android:textColor="@color/homecare_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPurchaseDate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:clickable="true"
            android:focusable="false"
            android:hint="Select purchase date"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/homecare_text"
            android:textColorHint="@color/homecare_muted_text" />

        <!-- Warranty -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Warranty Period"
            android:textColor="@color/homecare_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spWarranty"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input" />

        <!-- Last Service Date -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Last Service Date"
            android:textColor="@color/homecare_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etLastServiceDate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:clickable="true"
            android:focusable="false"
            android:hint="Select last service date"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/homecare_text"
            android:textColorHint="@color/homecare_muted_text" />

        <!-- Service Interval -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Service Interval"
            android:textColor="@color/homecare_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spServiceInterval"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input" />

        <!-- Repair Person -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Repair Person Name"
            android:textColor="@color/homecare_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etRepairPerson"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Enter repair person's name"
            android:inputType="textCapSentences"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/homecare_text"
            android:textColorHint="@color/homecare_muted_text" />

        <!-- Repair Phone -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Repair Person Phone"
            android:textColor="@color/homecare_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etRepairPhone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Enter phone number"
            android:inputType="phone"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/homecare_text"
            android:textColorHint="@color/homecare_muted_text" />

        <!-- Save Button -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAppliance"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:text="Save Appliance"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/homecare_primary"
            app:cornerRadius="14dp"
            app:strokeWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>

</ScrollView>