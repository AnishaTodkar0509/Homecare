<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/homecare_background"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="20dp">

    <!-- Header -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Appliances"
        android:textColor="@color/homecare_text"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Manage your household appliances"
        android:textColor="@color/homecare_secondary_text"
        android:textSize="14sp" />

    <!-- Search Bar -->
    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_appliance_card"
        app:iconifiedByDefault="false"
        app:queryHint="Search appliances..." />

    <!-- Appliance List -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAppliances"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

    <!-- Empty Message -->

    <TextView
        android:id="@+id/tvEmptyMessage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No appliances added yet"
        android:textColor="@color/homecare_secondary_text"
        android:textSize="16sp"
        android:visibility="gone" />

</LinearLayout>