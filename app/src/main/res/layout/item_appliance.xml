<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="14dp"
    android:layout_marginHorizontal="4dp"
    android:layout_marginTop="4dp"
    android:padding="18dp"
    android:background="@drawable/bg_appliance_card"
    android:elevation="4dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvApplianceIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="🏠"
            android:textSize="23sp"
            android:background="@drawable/bg_icon_circle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvApplianceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Living Room AC"
                android:textColor="@color/homecare_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvApplianceCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Air Conditioner"
                android:textColor="@color/homecare_secondary_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvApplianceBrand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Samsung • AR12"
                android:textColor="@color/homecare_muted_text"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/homecare_primary"
            android:textSize="30sp" />

    </LinearLayout>

</LinearLayout>